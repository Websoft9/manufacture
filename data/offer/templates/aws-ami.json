{
  "schemaVersion": 1,
  "templateId": "aws-ami-v1",
  "target": {
    "platform": "aws",
    "service": "marketplace-catalog",
    "entityType": "AmiProduct@1.0",
    "changeType": "UpdateInformation"
  },
  "AdditionalResources": [
    {
      "Text": "{catalog.name} Image Guide by Websoft9",
      "Url": "https://support.websoft9.com/en/docs/{catalog.id}"
    },
    {
      "Text": "Install Websoft9 on AWS",
      "Url": "https://support.websoft9.com/en/docs/install-aws"
    }
  ],
  "content": {
    "ProductTitle": "{catalog.name} on AWS - Preconfigured, Hardened, Ready in Minutes",
    "ShortDescription": "Deploy self-hosted {catalog.name} Community Edition on AWS. {catalog.summary} {vendor.consoleSummary}",
    "Highlights": [
      "{vendor.highlights[0]}",
      "{vendor.highlights[1]}",
      "{vendor.highlights[2]}"
    ],
    "SearchKeywords": "{catalog.searchKeywords}",
    "SupportDescription": "{vendor.supportSummary}\nContact: {vendor.supportContact}\n{vendor.supportScope}"
  },
  "longDescriptionSections": [
    {
      "heading": "",
      "text": "{catalog.name} {catalog.version} runs on AWS for self-hosted deployment. {catalog.summary} {vendor.consoleSummary}"
    },
    {
      "heading": "What is included?",
      "text": "{catalog.includedComponentsText}"
    },
    {
      "heading": "Use cases",
      "text": "{catalog.useCasesText}"
    },
    {
      "heading": "What you pay for",
      "text": "{vendor.billingSummary}"
    },
    {
      "heading": "Do I need SSH?",
      "text": "{vendor.sshSummary}"
    },
    {
      "heading": "Trademark statement",
      "text": "{vendor.trademarkStatement}"
    },
    {
      "heading": "About {catalog.name}",
      "text": "{catalog.overview}"
    },
    {
      "heading": "About Websoft9",
      "text": "{vendor.aboutVendor}"
    }
  ]
}
