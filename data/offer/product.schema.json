{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Marketplace product master data",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "key", "application", "listings"],
  "properties": {
    "schemaVersion": {"const": 1},
    "key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "summary", "includedComponents", "useCases", "searchKeywords", "versions"],
      "properties": {
        "name": {"$ref": "#/$defs/text"},
        "edition": {"$ref": "#/$defs/text"},
        "summary": {"$ref": "#/$defs/text"},
        "overview": {"$ref": "#/$defs/text"},
        "valueProposition": {"$ref": "#/$defs/text"},
        "version": {"$ref": "#/$defs/text"},
        "includedComponents": {"$ref": "#/$defs/textList"},
        "useCases": {"$ref": "#/$defs/textList"},
        "searchKeywords": {"$ref": "#/$defs/keywords"},
        "versions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}
      }
    },
    "listings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aws"],
      "properties": {
        "aws": {
          "type": "object",
          "additionalProperties": false,
          "required": ["entityType", "entityId", "templateId", "locale", "contentOverrides", "categories", "additionalResources", "logoUrl", "videoUrls"],
          "properties": {
            "entityType": {"const": "AmiProduct@1.0"},
            "entityId": {"type": ["string", "null"], "pattern": "^(prod-[a-zA-Z0-9]+|[a-fA-F0-9]{8}-[a-fA-F0-9-]{27})$"},
            "publicUrl": {"type": "string", "pattern": "^https://[^\\s]+$"},
            "templateId": {"const": "aws-ami-v1"},
            "locale": {"const": "en-US"},
            "contentOverrides": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ProductTitle": {"$ref": "#/$defs/text"},
                "ShortDescription": {"$ref": "#/$defs/text"},
                "LongDescription": {"$ref": "#/$defs/text"},
                "SupportDescription": {"$ref": "#/$defs/text"},
                "Highlights": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/text"}},
                "SearchKeywords": {"$ref": "#/$defs/keywords"}
              }
            },
            "categories": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
            "additionalResources": {
              "type": "array", "maxItems": 3,
              "items": {
                "type": "object", "additionalProperties": false, "required": ["Text", "Url"],
                "properties": {"Text": {"$ref": "#/$defs/text"}, "Url": {"$ref": "#/$defs/url"}}
              }
            },
            "logoUrl": {"type": ["string", "null"], "pattern": "^https://[^\\s?#]+$"},
            "videoUrls": {"type": "array", "maxItems": 1, "items": {"$ref": "#/$defs/url"}},
            "deployment": {
              "type": "object", "additionalProperties": false,
              "required": ["accessSummary", "usageInstructions"],
              "properties": {
                "accessSummary": {"$ref": "#/$defs/text"},
                "usageInstructions": {"$ref": "#/$defs/text"}
              }
            },
            "commercial": {
              "type": "object", "additionalProperties": false,
              "required": ["billingSummary", "refundPolicy"],
              "properties": {
                "billingSummary": {"$ref": "#/$defs/text"},
                "refundPolicy": {"type": ["string", "null"], "minLength": 1}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "url": {"type": "string", "pattern": "^https://[^\\s?#]+$"},
    "textList": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "keywords": {"type": "array", "minItems": 1, "maxItems": 15, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 50, "pattern": "\\S"}}
  }
}
