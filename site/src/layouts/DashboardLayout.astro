---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Marketplace Dashboard",
  description = "Websoft9 Marketplace application catalog and listing status.",
} = Astro.props;
const base = import.meta.env.BASE_URL;
const basePath = base.replace(/\/+$/, "");
const homeHref = base;
const appsHref = `${basePath}/apps`;
const faviconHref = `${base}favicon.svg`;
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const route =
  basePath && (pathname === basePath || pathname.startsWith(`${basePath}/`))
    ? pathname.slice(basePath.length) || "/"
    : pathname;
const isOverview = route === "/";
const isApps = route === "/apps" || route.startsWith("/apps/");
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <title>{title}</title>
  </head>
  <body>
    <div class="shell">
      <aside class="sidebar">
        <a class="brand" href={homeHref}>
          <span class="brand-mark">W9</span>
          <span class="brand-copy">
            <strong>Websoft9</strong>
            <small>Marketplace</small>
          </span>
        </a>

        <nav class="nav" aria-label="主导航">
          <a class:list={["nav-item", { active: isOverview }]} href={homeHref}>
            <span class="nav-dot"></span>
            总览
          </a>
          <a class:list={["nav-item", { active: isApps }]} href={appsHref}>
            <span class="nav-dot"></span>
            应用列表
          </a>
        </nav>

        <div class="sidebar-note">
          <span class="eyebrow">数据说明</span>
          <p>页面在构建时直接读取两个公开数据源，生成静态 HTML。</p>
        </div>
      </aside>

      <main class="main">
        <slot />
        <footer class="footer">
          <span>Websoft9 Marketplace Dashboard</span>
          <span>Built with Astro</span>
        </footer>
      </main>
    </div>
  </body>
</html>
