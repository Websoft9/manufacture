---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import {
  PLATFORMS,
  appMetadataMap,
  loadAppMetadata,
  loadMarketplaceData,
  type AppMetadata,
  type AppRow,
  type CatalogProduct,
} from "../../lib/marketplace";

export async function getStaticPaths() {
  const [{ rows, catalog }, metadataItems] = await Promise.all([
    loadMarketplaceData(),
    loadAppMetadata(),
  ]);
  const metadataByKey = appMetadataMap(metadataItems);
  const rowsByKey = new Map(rows.map((row) => [row.key, row]));
  const catalogKeys = catalog.map((product) => product.key);
  const availableKeys = new Set(catalogKeys);
  const missing = catalog.filter((product) => !metadataByKey.has(product.key));

  if (missing.length > 0) {
    throw new Error(
      `Missing app metadata for: ${missing.map((product) => product.key).join(", ")}`,
    );
  }

  return catalog.map((product) => ({
    params: { key: product.key },
    props: {
      product,
      metadata: metadataByKey.get(product.key)!,
      row: rowsByKey.get(product.key),
      catalogKeys: [...availableKeys],
    },
  }));
}

interface Props {
  product: CatalogProduct;
  metadata: AppMetadata;
  row?: AppRow;
  catalogKeys: string[];
}

const { product, metadata, row, catalogKeys } = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/+$/, "");
const appsHref = `${basePath}/apps`;
const detailHrefFor = (key: string) => `${basePath}/apps/${key}`;
const availableKeys = new Set(catalogKeys);
const name = product.trademark ?? product.key;
const summary = product.summary ?? product.overview ?? "";
const logoUrl = product.logo?.imageurl;
const overview = product.overview?.trim() ?? "";
const description = product.description?.trim() ?? "";
const categories = (product.catalogCollection?.items ?? [])
  .map((item) => item.title)
  .filter((title): title is string => Boolean(title));
const versions = Array.from(
  new Set((product.distribution ?? []).flatMap((entry) => entry.value ?? [])),
).filter(Boolean);
const distributions = (product.distribution ?? [])
  .map((entry) => entry.key)
  .filter((key): key is string => Boolean(key));
const relatedApps = (product.relatedAppsCollection?.items ?? []).filter(
  (item): item is { key: string; trademark: string } =>
    Boolean(item.key && item.trademark),
);
const platformLinks = row
  ? PLATFORMS.map((platform) => ({
      platform,
      links: row.links[platform.key],
    })).filter((entry) => entry.links.length > 0)
  : [];
---

<DashboardLayout
  title={`${name} | Websoft9 Marketplace`}
  description={summary || `Websoft9 Marketplace application: ${name}`}
>
  <div class="detail-back">
    <a class="button" href={appsHref}>← 返回应用列表</a>
  </div>

  <header class="page-header detail-header">
    <div class="detail-identity">
      {logoUrl ? (
        <img class="detail-logo" src={logoUrl} alt={`${name} logo`} />
      ) : (
        <span class="detail-logo detail-logo-fallback">
          {name.slice(0, 2)}
        </span>
      )}
      <div>
        <span class="eyebrow">Application / Detail</span>
        <h1>{name}</h1>
        <p class="lede">{summary}</p>
        <div class="detail-links">
          {categories.map((category) => (
            <span class="chip">{category}</span>
          ))}
          {product.websiteurl ? (
            <a
              class="button"
              href={product.websiteurl}
              target="_blank"
              rel="noreferrer"
            >
              官网
            </a>
          ) : null}
        </div>
      </div>
    </div>
  </header>

  <div class="detail-grid">
    <div class="detail-main">
      <section class="panel detail-panel">
        <div class="panel-heading">
          <div>
            <h2>应用介绍</h2>
            <p>来自 product_en.json 的应用概述和说明。</p>
          </div>
        </div>
        {overview ? <p class="detail-copy">{overview}</p> : null}
        {description && description !== overview ? (
          <p class="detail-copy detail-copy-secondary">{description}</p>
        ) : null}
        {!overview && !description ? (
          <p class="detail-copy">{summary}</p>
        ) : null}
      </section>

      <section class="panel detail-panel">
        <div class="panel-heading">
          <div>
            <h2>Use Cases</h2>
            <p>适合使用 {name} 的典型场景。</p>
          </div>
        </div>
        <p class="detail-copy">{metadata.useCases}</p>
      </section>

      <section class="panel detail-panel">
        <div class="panel-heading">
          <div>
            <h2>Keywords</h2>
            <p>AWS Marketplace 搜索关键词，最多 15 个，每个不超过 50 字符。</p>
          </div>
        </div>
        <div class="chip-list">
          {metadata.keywords.map((keyword) => (
            <span class="chip">{keyword}</span>
          ))}
        </div>
      </section>
    </div>

    <aside class="detail-side">
      <section class="panel detail-panel">
        <div class="panel-heading">
          <div>
            <h2>详情</h2>
            <p>应用 key、版本和分类。</p>
          </div>
        </div>
        <dl class="detail-facts">
          <div>
            <dt>Key</dt>
            <dd><code>{product.key}</code></dd>
          </div>
          {versions.length > 0 ? (
            <div>
              <dt>Versions</dt>
              <dd>{versions.join(", ")}</dd>
            </div>
          ) : null}
          {distributions.length > 0 ? (
            <div>
              <dt>Distribution</dt>
              <dd>{distributions.join(", ")}</dd>
            </div>
          ) : null}
        </dl>
      </section>

      {platformLinks.length > 0 ? (
        <section class="panel detail-panel">
          <div class="panel-heading">
            <div>
              <h2>Marketplace</h2>
              <p>该应用在各平台的上架链接。</p>
            </div>
          </div>
          <div class="detail-marketplaces">
            {platformLinks.map(({ platform, links }) => (
              <div class="detail-marketplace">
                <strong>{platform.label}</strong>
                {links.map((link) => (
                  <a href={link.url} target="_blank" rel="noreferrer">
                    {link.code}
                  </a>
                ))}
              </div>
            ))}
          </div>
        </section>
      ) : null}

      {relatedApps.length > 0 ? (
        <section class="panel detail-panel">
          <div class="panel-heading">
            <div>
              <h2>相关应用</h2>
              <p>同一应用目录中的关联应用。</p>
            </div>
          </div>
          <div class="chip-list">
            {relatedApps.map((app) =>
              availableKeys.has(app.key) ? (
                <a class="chip" href={detailHrefFor(app.key)}>
                  {app.trademark}
                </a>
              ) : (
                <span class="chip">{app.trademark}</span>
              ),
            )}
          </div>
        </section>
      ) : null}
    </aside>
  </div>
</DashboardLayout>
