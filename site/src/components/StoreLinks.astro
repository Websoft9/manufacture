---
import type { StoreConfig } from "../lib/marketplace";

interface Props {
  stores: StoreConfig[];
}

const { stores } = Astro.props;
---

{
  stores.length > 0 && (
    <span class="platform-stores">
      {stores.map((store) => (
        <a
          class="store-icon"
          href={store.url}
          target="_blank"
          rel="noreferrer"
          aria-label={`访问 ${store.label}`}
          title={`访问 ${store.label}`}
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
            <path d="M15 3h6v6" />
            <path d="M10 14 21 3" />
          </svg>
        </a>
      ))}
    </span>
  )
}
